<section class="hero">
  <div class="hero__media">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', class: 'hero__image' }}
    {% endif %}
  </div>

  <div class="hero__content container">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    {% if section.settings.button_link != blank %}
      <a class="button button--light" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Luxury hero",
  "settings": [
    {"type":"image_picker","id":"image","label":"Hero image"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE NEW COLLECTION"},
    {"type":"text","id":"heading","label":"Heading","default":"Objects of quiet distinction"},
    {"type":"textarea","id":"text","label":"Text","default":"Refined pieces designed to be noticed without asking for attention."},
    {"type":"text","id":"button_label","label":"Button label","default":"Explore collection"},
    {"type":"url","id":"button_link","label":"Button link"}
  ],
  "presets": [{"name":"Luxury hero"}]
}
{% endschema %}
