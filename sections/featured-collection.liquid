{% assign collection = section.settings.collection %}

<section class="section">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {% if collection != blank %}
        <a class="text-link" href="{{ collection.url }}">View all</a>
      {% endif %}
    </div>

    <div class="product-grid">
      {% if collection != blank %}
        {% for product in collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="product-card">
            <div class="product-card__media placeholder"></div>
            <p>Product title</p>
            <span>€0.00</span>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Featured collection",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"CURATED"},
    {"type":"text","id":"heading","label":"Heading","default":"Signature pieces"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"products_to_show","label":"Products","min":2,"max":8,"step":1,"default":4}
  ],
  "presets":[{"name":"Featured collection"}]
}
{% endschema %}
