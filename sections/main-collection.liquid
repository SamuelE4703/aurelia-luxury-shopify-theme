<section class="section">
  <div class="container">
    <div class="collection-heading">
      <p class="eyebrow">Collection</p>
      <h1>{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="collection-description">{{ collection.description }}</div>
      {% endif %}
    </div>

    <form class="filters" method="get">
      <label>
        Sort
        <select name="sort_by" onchange="this.form.submit()">
          {% for option in collection.sort_options %}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
              {{ option.name }}
            </option>
          {% endfor %}
        </select>
      </label>

      {% for filter in collection.filters %}
        {% if filter.type == 'price_range' %}
          <label>
            {{ filter.label }}
            <input type="number" name="{{ filter.min_value.param_name }}" placeholder="Min">
            <input type="number" name="{{ filter.max_value.param_name }}" placeholder="Max">
          </label>
        {% else %}
          <label>
            {{ filter.label }}
            <select name="{{ filter.param_name }}">
              <option value="">All</option>
              {% for value in filter.values %}
                <option value="{{ value.value }}" {% if value.active %}selected{% endif %}>
                  {{ value.label }}{% if value.count %} ({{ value.count }}){% endif %}
                </option>
              {% endfor %}
            </select>
          </label>
        {% endif %}
      {% endfor %}
    </form>

    <div class="product-grid">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <p>No products found.</p>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Main collection",
  "settings":[]
}
{% endschema %}
