<article class="product-card reveal">
  <a href="{{ product.url }}" class="product-card__link">
    <div class="product-card__media">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'product-card__image' }}
      {% endif %}
      {% if product.images[1] %}
        {{ product.images[1] | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'product-card__image product-card__image--hover' }}
      {% endif %}
    </div>

    <div class="product-card__meta">
      <div>
        <h3>{{ product.title }}</h3>
        {% if product.vendor != blank %}<span>{{ product.vendor }}</span>{% endif %}
      </div>
      <p>{{ product.price | money }}</p>
    </div>
  </a>
</article>
